PORT=5000
HOST=0.0.0.0
DEBUG=false

# Local or mounted model path.
MODEL_PATH=./models/best.pt

# Optional: download the model automatically from Hugging Face when MODEL_PATH is missing.
HF_MODEL_REPO=Abs6187/Helmet-License-Plate-Detection
HF_MODEL_FILENAME=best.pt
HF_TOKEN=
# Use "space" when model is in a HuggingFace Space, "model" for a model repo
HF_REPO_TYPE=space

# GPU auto-detection uses CUDA when available. Keep `auto` for portable deployments.
YOLO_DEVICE=auto
YOLO_CONFIDENCE=0.45
VIDEO_FRAME_STRIDE=3
OCR_LANGS=en

# Optional SMS configuration (Twilio).
# Get these from https://www.twilio.com/console
# Account SID starts with AC..., Auth Token is 32-char hex
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEFAULT_NOTIFICATION_TO=

# Frontend talks to the co-hosted API by default.
VITE_API_BASE_URL=/api
